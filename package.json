{
  "name": "anime-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:navigation": "node --experimental-strip-types --test scripts/navigation.test.mjs",
    "test:journal": "node --experimental-strip-types --test scripts/journal.test.mjs",
    "test:polish": "node scripts/polish-smoke.mjs",
    "test:viewport": "node --experimental-strip-types --test scripts/viewport.test.mjs",
    "models:build": "blender -b --python scripts/build-characters.py",
    "test:models": "node --test scripts/models.test.mjs",
    "test:models:browser": "node scripts/models-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
