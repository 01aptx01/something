{
  "name": "anime-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:navigation": "node --experimental-strip-types --test scripts/navigation.test.mjs",
    "test:journal": "node --experimental-strip-types --test scripts/journal.test.mjs",
    "test:polish": "node scripts/polish-smoke.mjs",
    "test:viewport": "node --experimental-strip-types --test scripts/viewport.test.mjs",
    "models:build": "blender -b --python-exit-code 1 --python scripts/sculpt-reference-cast.py -- && blender -b --python-exit-code 1 --python scripts/sculpt-eren.py",
    "test:models": "node --test scripts/models.test.mjs",
    "test:models:browser": "node scripts/models-smoke.mjs",
    "test:character-regions": "node --experimental-strip-types --test scripts/character-regions.test.mjs",
    "test:character-entry": "node scripts/character-entry-smoke.mjs",
    "skill:install": "node scripts/setup-img2threejs.mjs",
    "skill:check": "node scripts/setup-img2threejs.mjs --check",
    "skill:cast:init": "node scripts/img2threejs-cast.mjs init",
    "skill:cast:status": "node scripts/img2threejs-cast.mjs status",
    "skill:cast:admit": "node scripts/img2threejs-cast.mjs admit",
    "models:eren": "blender -b --python-exit-code 1 --python scripts/sculpt-eren.py",
    "test:eren:browser": "node scripts/eren-smoke.mjs",
    "sculpt:zoro:build": "node scripts/sculpt-zoro.mjs",
    "sculpt:zoro:capture": "node scripts/capture-sculpt.mjs",
    "sculpt:zoro:geometry": "node --experimental-strip-types scripts/inspect-sculpt-geometry.mjs",
    "test:sculpt:browser": "node scripts/sculpt-studio-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
